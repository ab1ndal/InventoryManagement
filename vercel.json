{
  "trailingSlash": false,
  "functions": {
    "api/render.js": { "includeFiles": "build/shell.html" }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/hero/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/images/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "all" }]
    },
    {
      "source": "/(admin(?:/.*)?|unauthorized|cart|checkout|wishlist|login|account(?:/.*)?|search|track|order/.*|refund-choice/.*|shell\\.html)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "rewrites": [
    {
      "source": "/images/:path*",
      "destination": "https://epotsxdugwfhyeiudjox.supabase.co/storage/v1/object/public/mockups/:path*"
    },
    {
      "source": "/sb-rest/:path*",
      "destination": "https://epotsxdugwfhyeiudjox.supabase.co/rest/v1/:path*"
    },
    {
      "source": "/sb-auth/:path*",
      "destination": "https://epotsxdugwfhyeiudjox.supabase.co/auth/v1/:path*"
    },
    {
      "source": "/hooks/courier-status",
      "destination": "https://epotsxdugwfhyeiudjox.supabase.co/functions/v1/courier-status"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feeds/google-products.xml",
      "destination": "/api/merchant-feed"
    },
    {
      "source": "/(admin(?:/.*)?|unauthorized|cart|checkout|wishlist|login|account(?:/.*)?|search|track|order/.*|refund-choice/.*)",
      "destination": "/shell.html"
    },
    {
      "source": "/",
      "destination": "/api/render"
    },
    {
      "source": "/:path(.+)",
      "destination": "/api/render?ssr_path=:path"
    }
  ]
}
